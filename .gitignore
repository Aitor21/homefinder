.venv/
__pycache__/
*.pyc

# Cached API responses and bulk rasters. Safe to delete; the pipeline refetches.
pipeline/cache/
pipeline/*.log

# Stage outputs are derived data.
pipeline/data/

# The dataset the web app ships. Only the compressed copy is tracked: it is the
# one the app actually loads, and at 4.2 MB against 17.5 it is the difference
# between a repository that stays usable across data revisions and one that does
# not. The uncompressed file is regenerated by `python pipeline/emit.py`.
web/public/data/*
!web/public/data/towns.json.gz

node_modules/
web/dist/

# Local tooling and personal output. A public repository is a bad place for
# either: the first is machine-specific, the second is one person's search.
.claude/
SHORTLIST.txt
web/tsconfig.tsbuildinfo

